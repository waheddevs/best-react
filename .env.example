# Generate a strong secret before running real authentication.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
BEST_SITE_URL=http://localhost:3000

# Sibling NestJS API used for credential login, token validation, and app data.
BEST_API_INTERNAL_URL=http://localhost:4000

# Local UI review only. This flag is ignored in production builds.
BEST_DASHBOARD_PREVIEW=false
