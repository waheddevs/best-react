# Generate a strong secret before running real authentication.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Sibling NestJS API identity exchange. Keep this secret server-only and make it
# identical to best-server AUTH_EXCHANGE_SECRET, but different from AUTH_SECRET.
BEST_API_INTERNAL_URL=http://localhost:4000
AUTH_EXCHANGE_SECRET=replace-with-a-different-32-character-secret
AUTH_EXCHANGE_ISSUER=best-web
AUTH_EXCHANGE_AUDIENCE=best-api

# Local UI review only. This flag is ignored in production builds.
BEST_DASHBOARD_PREVIEW=false

# Google OAuth
AUTH_GOOGLE_ID=replace-with-google-client-id
AUTH_GOOGLE_SECRET=replace-with-google-client-secret

# Facebook Login
AUTH_FACEBOOK_ID=replace-with-facebook-app-id
AUTH_FACEBOOK_SECRET=replace-with-facebook-app-secret

# Sign in with Apple
AUTH_APPLE_ID=replace-with-apple-services-id
AUTH_APPLE_SECRET=replace-with-apple-client-secret
